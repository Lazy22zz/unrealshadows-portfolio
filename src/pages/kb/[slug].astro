---
import Article from "../../layouts/Article.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const all = (await getCollection("kb")).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Article title={entry.data.title} summary={entry.data.summary} eyebrow={`知识库 · ${entry.data.topic}`} headings={headings}
  sources={entry.data.sources} lang="zh-CN" back={{ href: "/kb/", label: "知识库目录" }}>
  <Content />
  <nav class="pn">
    {prev ? <a class="card" href={`${base}/kb/${prev.id}/`}><span class="small muted">← 上一篇</span><br />{prev.data.title}</a> : <span />}
    {next ? <a class="card" href={`${base}/kb/${next.id}/`} style="text-align:right"><span class="small muted">下一篇 →</span><br />{next.data.title}</a> : <span />}
  </nav>
</Article>
<style>.pn { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 48px; } .pn a { text-decoration: none; color: var(--text); }</style>
